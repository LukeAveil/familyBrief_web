# ─────────────────────────────────────────────────────────────────────────────
# Example env — copy to .env.local and fill in real values (never commit).
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic — used by /api/upload and /api/chat for extraction and Q&A.
ANTHROPIC_API_KEY=

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Signs session cookies and CSRF tokens. Any long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Resend API key. Auth.js reads this automatically by the AUTH_<PROVIDER>_KEY
# convention — no need to name it in auth.ts. From: https://resend.com/api-keys
AUTH_RESEND_KEY=

# The From address on the magic-link email. Must be a domain verified in Resend.
# Example: "FamilyBrief <noreply@familybrief.example>"
AUTH_EMAIL_FROM=

# ─── Supabase Postgres ───────────────────────────────────────────────────────
# Session pooler URL (Supavisor, port 5432 — NOT the transaction pooler at 6543,
# which breaks pg's prepared-statement cache used by @auth/pg-adapter).
# Find under Supabase Dashboard → Project Settings → Database → Connection pooling
# → "Session" mode. Looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
